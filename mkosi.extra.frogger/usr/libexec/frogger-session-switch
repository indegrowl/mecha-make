#!/bin/bash
# Switches the greetd session: steam (one boot only) or mechanix.
# Run as root by frogger-session-switch@<name>.service.

flag_dir=${FROGGER_SESSION_DIR:-/run/frogger-session}

stop_greetd() {
    systemctl stop greetd.service
}

start_greetd() {
    systemctl start --no-block greetd.service
}

# The old session's compositor owns its VT's switching until it has exited; a
# greetd that starts earlier waits forever for its own VT to become active.
wait_seat_free() {
    local i
    for i in $(seq 1 50); do
        loginctl list-sessions --no-legend | awk '$4 == "seat0" { busy = 1 } END { exit !busy }' || return 0
        sleep "${SEAT_POLL:-0.2}"
    done
}

switch_to() {
    case "$1" in
    steam)
        mkdir -p "$flag_dir"
        chmod 0777 "$flag_dir"
        echo steam >"$flag_dir/next"
        chmod 0666 "$flag_dir/next" ;;
    mechanix)
        rm -f "$flag_dir/next" ;;
    *)
        echo "usage: frogger-session-switch steam|mechanix" >&2
        return 1 ;;
    esac
    stop_greetd
    # greetd only runs initial_session again when its run marker is gone.
    rm -f "${GREETD_RUN:-/run/greetd.run}"
    wait_seat_free
    start_greetd
}

[ -n "${FROGGER_SESSION_LIB:-}" ] && return 0

switch_to "$1"
