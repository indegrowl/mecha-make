// Let the local phone user switch between Mechanix and Steam without a password.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        subject.user == "mecha" && subject.local && subject.active &&
        action.lookup("verb") == "start" &&
        (action.lookup("unit") == "frogger-session-switch@steam.service" ||
         action.lookup("unit") == "frogger-session-switch@mechanix.service")) {
        return polkit.Result.YES;
    }
});
